# ==============================================================================
# MathModelAgent 后端配置文件示例
# 复制此文件为 .env.dev 并填写实际配置
# 参考文档：https://github.com/jihe520/MathModelAgent
# 配置项格式：KEY=VALUE（等号两侧无空格）
# 修改后需重启后端服务生效
# ==============================================================================

# ============ 环境设置 ============
# 当前运行环境：dev（开发）/ prod（生产）
# 决定加载对应的配置文件
ENV=dev

# ============ 各 Agent API 配置 ============
# 系统包含4个核心Agent，每个独立配置：
# - Coordinator：协调器，负责任务调度和决策
# - Modeler：建模手，负责数学建模和算法设计
# - Coder：代码手，负责代码编写和执行
# - Writer：论文手，负责报告撰写和文档生成

# ------------------------------
# 协调器 Agent 配置
# ------------------------------
# API类型：openai-chat / openai-responses / anthropic
COORDINATOR_API_TYPE=openai-chat
# API密钥（请填写你的密钥）
COORDINATOR_API_KEY=
# 模型名称（如：deepseek-chat, gpt-4o-mini）
COORDINATOR_MODEL=
# 同端点备用模型，逗号分隔（过载/超时时按序切换）。留空则只用上面的 MODEL
COORDINATOR_MODELS=
# API服务地址（如：https://api.deepseek.com/v1）
COORDINATOR_BASE_URL=
# 最大输出token数（控制响应长度）
# 注意：anthropic 协议下 thinking tokens 计入 max_tokens；GLM 等 anthropic 兼容端
# 的 budget_tokens 是软约束（思考可超用），建议直接设为模型输出上限（GLM-5.3 为 128000）防思考挤占正文
COORDINATOR_MAX_TOKENS=128000
# 上下文窗口（token，用于对话历史截断；默认 128000）
# COORDINATOR_CONTEXT_WINDOW=128000
# 思考深度档位（off/minimal/low/medium/high/max/xhigh，按服务商支持透传；留空用默认）
COORDINATOR_REASONING_EFFORT=
# 思考token预算（仅 anthropic 协议生效，如 16384；需小于最大输出token数）
COORDINATOR_THINKING_BUDGET=

# ------------------------------
# 建模 Agent 配置
# ------------------------------
# API类型
MODELER_API_TYPE=openai-chat
# API密钥
MODELER_API_KEY=
# 模型名称
MODELER_MODEL=
# 同端点备用模型，逗号分隔（过载/超时时按序切换）。留空则只用上面的 MODEL
MODELER_MODELS=
# API服务地址
MODELER_BASE_URL=
# 最大输出token数
MODELER_MAX_TOKENS=128000
# 上下文窗口（token；默认 128000）
# MODELER_CONTEXT_WINDOW=128000
# 思考深度档位（off/minimal/low/medium/high/max/xhigh，按服务商支持透传；留空用默认）
MODELER_REASONING_EFFORT=
# 思考token预算（仅 anthropic 协议生效，如 16384；需小于最大输出token数）
MODELER_THINKING_BUDGET=

# ------------------------------
# 编码 Agent 配置
# ------------------------------
# API类型
CODER_API_TYPE=openai-chat
# API密钥
CODER_API_KEY=
# 模型名称
CODER_MODEL=
# 同端点备用模型，逗号分隔（过载/超时时按序切换）。留空则只用上面的 MODEL
CODER_MODELS=
# API服务地址
CODER_BASE_URL=
# 最大输出token数
CODER_MAX_TOKENS=128000
# 上下文窗口（token；默认 128000）
# CODER_CONTEXT_WINDOW=128000
# 思考深度档位（off/minimal/low/medium/high/max/xhigh，按服务商支持透传；留空用默认）
CODER_REASONING_EFFORT=
# 思考token预算（仅 anthropic 协议生效，如 16384；需小于最大输出token数）
CODER_THINKING_BUDGET=

# ------------------------------
# 写作 Agent 配置
# ------------------------------
# API类型
WRITER_API_TYPE=openai-chat
# API密钥
WRITER_API_KEY=
# 模型名称
WRITER_MODEL=
# 同端点备用模型，逗号分隔（过载/超时时按序切换）。留空则只用上面的 MODEL
WRITER_MODELS=
# API服务地址
WRITER_BASE_URL=
# 最大输出token数
WRITER_MAX_TOKENS=128000
# 上下文窗口（token；默认 128000）
# WRITER_CONTEXT_WINDOW=128000
# 思考深度档位（off/minimal/low/medium/high/max/xhigh，按服务商支持透传；留空用默认）
WRITER_REASONING_EFFORT=
# 思考token预算（仅 anthropic 协议生效，如 16384；需小于最大输出token数）
WRITER_THINKING_BUDGET=

# ------------------------------
# 评审模型配置（G2-L2 代码评审 / G4 终审 / 检查点 AI 预审）
# ------------------------------
# 留空则回退使用 Coordinator 的模型配置
REVIEW_API_TYPE=
REVIEW_API_KEY=
REVIEW_MODEL=
# 同端点备用模型，逗号分隔（过载/超时时按序切换）。留空则只用上面的 MODEL
REVIEW_MODELS=
REVIEW_BASE_URL=
REVIEW_MAX_TOKENS=

# ============ 可选服务配置 ============
# 以下服务为可选功能，不配置不影响核心建模流程

# ------------------------------
# E2B 代码执行环境（可选）
# 提供安全的Python代码沙箱执行环境
# 不配置则使用本地解释器执行代码
# ------------------------------
# E2B平台API密钥（需注册获取）
E2B_API_KEY=

# ------------------------------
# OpenAlex 学术搜索（可选）
# 论文手 search_papers 工具的数据源，返回规范书目元数据
# 邮箱无需注册验证，任意可联系邮箱即可进入礼貌池（免费额度 10 万 credits/天）
# ------------------------------
# OpenAlex邮箱（免费额度）
OPENALEX_EMAIL=
# OpenAlex API密钥（付费用户）
OPENALEX_API_KEY=

# ------------------------------
# Exa 语义搜索（可选）
# 论文手 search_web 工具的数据源，中英文语义检索强
# API Key 从 https://exa.ai 获取
# ------------------------------
EXA_API_KEY=

# ============ 系统配置 ============
# 基础系统运行参数

# 日志级别：DEBUG/INFO/WARN/ERROR
LOG_LEVEL=DEBUG
# 最大聊天轮数（空表示无限制，数字表示上限）
# MAX_CHAT_TURNS=  # 取消注释并设置数字，或完全删除此行使用默认值

# API调用失败重试次数
MAX_RETRIES=3
# LLM 流式读超时（秒）：两次增量间隔超过该值即断开，避免 zen 过载 hold 十几分钟
# LLM_READ_TIMEOUT=180

# ------------------------------
# Redis 配置
# 用于消息队列和状态管理
# ------------------------------
# Redis连接地址（本地开发）
REDIS_URL=redis://localhost:6379/0
# Docker Compose环境使用此地址
# REDIS_URL=redis://redis:6379/0
# 连接池上限（默认 10）
# REDIS_MAX_CONNECTIONS=10

# ------------------------------
# CORS 跨域配置
# 允许前端访问后端的域名列表
# ------------------------------
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ------------------------------
# 服务地址配置
# ------------------------------
# 后端服务访问地址
SERVER_HOST=http://localhost:8000

# ============ HIL 人机协作与质量门配置 ============
# Human-in-the-Loop，启用后人机协作审批功能
# 是否启用人机协作（true/false）
HIL_ENABLED=true
# 审批超时提示时间（秒）：超时仅提醒，无响应仍永久等待，绝不自动放行
HIL_TIMEOUT=300
# HIL_CHECKPOINTS 配置在代码中定义，包含：
# - problem_split: 问题拆分审批（检查点①）
# - model_selection: 模型选择审批（检查点②）
# - code_review: 代码审查审批（③由 G2 质量门覆盖，默认关闭）
# - paper_review: 终稿审批（检查点④）

# 自动模式（true/false）：质量门修复轮耗尽时自动降级放行并记录 auto_degraded 审计，
# 不再挂起等待人工；false 时挂起进入人工审批三分支（approve/revise/reject）
AUTO_MODE=false

# A/B 验证开关：整体关闭可还原上游基线做对照实验
# 质量门（G2 门循环 / G3 修复回路 / G4 终审）
QUALITY_GATES_ENABLED=true
# 三期 Agent 方法论契约（Modeler 蓝图 / Writer 论证 / Coder 图表 DoD）
AGENT_CONTRACTS_ENABLED=true

# ==============================================================================
# 配置示例参考：
# 
# 【DeepSeek 配置示例】
#   COORDINATOR_API_TYPE=openai-chat
#   COORDINATOR_API_KEY=sk-xxx
#   COORDINATOR_MODEL=deepseek-chat
#   COORDINATOR_BASE_URL=https://api.deepseek.com/v1
# 
# 【OpenAI 配置示例】
#   COORDINATOR_API_TYPE=openai-chat
#   COORDINATOR_API_KEY=sk-xxx
#   COORDINATOR_MODEL=gpt-4o-mini
#   COORDINATOR_BASE_URL=https://api.openai.com/v1
# 
# 【Anthropic 配置示例】
#   COORDINATOR_API_TYPE=anthropic
#   COORDINATOR_API_KEY=sk-ant-api03-xxx
#   COORDINATOR_MODEL=claude-3-opus-20240229
#   COORDINATOR_BASE_URL=https://api.anthropic.com/v1
# 
# 【Anthropic 兼容端配置示例（如智谱 GLM）】
#   COORDINATOR_API_TYPE=anthropic
#   COORDINATOR_API_KEY=你的密钥
#   COORDINATOR_MODEL=glm-5.3
#   COORDINATOR_BASE_URL=https://open.bigmodel.cn/api/anthropic
# 
# 使用步骤：
# 1. 复制此文件为 .env.dev
# 2. 填写各 Agent 的 API Key 和模型信息
# 3. 根据需要配置可选服务
# 4. 启动 Redis 服务
# 5. 启动后端服务
# ==============================================================================
